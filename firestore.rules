rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Permite acesso SOMENTE com autenticação válida do UID autorizado
    function autorizado() {
      return request.auth != null && request.auth.uid == 'mOGkv4yJZ1f7HlzOZPT8qqNRDdF3';
    }

    match /weeks/{id} {
      allow read, write: if autorizado();
    }

    match /appts/{id} {
      allow read, write: if autorizado();
    }

    match /config/{id} {
      allow read, write: if autorizado();
    }

    match /{document=**} { 
      allow read, write: if false; 
    }
  }
}
