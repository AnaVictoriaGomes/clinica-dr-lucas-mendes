rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null;
    }

    function versaoOk() {
      return !('_v' in request.resource.data) || request.resource.data._v is int;
    }

    match /weeks/{id} {
      allow read: if autorizado();
      allow create, update: if autorizado() 
        && id.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && versaoOk() 
        && request.resource.data.size() <= 80;
      allow delete: if autorizado();
    }

    match /appts/{id} {
      allow read: if autorizado();
      allow create, update: if autorizado() 
        && versaoOk()
        && request.resource.data.patient is string 
        && request.resource.data.patient.size() <= 200
        && request.resource.data.size() <= 30;
      allow delete: if autorizado();
    }

    match /config/{id} {
      allow read: if autorizado();
      allow create, update: if autorizado() 
        && (id == 'general' || id == 'main')
        && versaoOk() 
        && request.resource.data.size() <= 100;
      allow delete: if autorizado();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
